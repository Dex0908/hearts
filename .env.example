# ─── Database (Neon PostgreSQL) ───────────────────────────────────────────────
# Get these from your Neon dashboard: console.neon.tech
DATABASE_URL="postgresql://username:password@ep-xxx.us-east-1.aws.neon.tech/skyhearts?sslmode=require"
DIRECT_URL="postgresql://username:password@ep-xxx.us-east-1.aws.neon.tech/skyhearts?sslmode=require"

# ─── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET="your-super-secret-jwt-key-change-in-production-minimum-32-chars"
ADMIN_JWT_SECRET="your-admin-jwt-secret-change-in-production-minimum-32-chars"

# ─── App URLs ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3001"
NODE_ENV="development"

